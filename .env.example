# --- Database ---
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/immersia

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
ADMIN_SEED_EMAIL=admin@immersia.ng
ADMIN_SEED_PASSWORD=change-on-first-login
ADMIN_SEED_NAME=Mr Seun

# --- Paystack ---
# From: Paystack Dashboard → Settings → API Keys & Webhooks.
# The secret key also verifies webhook signatures. Use sk_test_… in dev, sk_live_… in prod.
PAYSTACK_SECRET_KEY=<your-paystack-secret-key>
PAYSTACK_PUBLIC_KEY=<your-paystack-public-key>

# --- Pricing (single source of truth: lib/pricing.ts) ---
# All amounts in KOBO (₦1 = 100 kobo). Leave unset to use the defaults shown here.
# These drive what campers are SHOWN and CHARGED, so keep them accurate.
PRICE_REGULAR_KOBO=10000000           # ₦100,000 boot camp fee (in-person)
PRICE_ONLINE_KOBO=5000000             # ₦50,000 flat fee for the online track (fully remote)
PRICE_ONLINE_EMBEDDED_KOBO=3500000    # +₦35,000 optional online Embedded Systems elective (kit + delivery, all-in)
PRICE_LAPTOP_RENTAL_KOBO=2000000      # +₦20,000 optional laptop rental (in-person only)
PRICE_ROBOTICS_ELECTIVE_KOBO=2500000  # +₦25,000 optional in-person Robotics & Embedded Systems elective
PRICE_DEPOSIT_KOBO=7500000            # ₦75,000 instalment deposit quoted in terms/FAQ (display only)
# Limited-time discounts are managed as promo codes in the admin panel (/admin/promos) —
# no env var needed.

# --- SMTP ---
# Fill these in with your mail provider's SMTP details. If you are using Gmail,
# the password should be a 16-character App Password, not your normal login.
# Google only shows that App Password once, so if you lose it you generate a new one.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-or-workspace-address@immersia.ng
SMTP_PASS=
SMTP_FROM="Immersia Boot Camp <noreply@immersia.ng>"
ADMIN_ALERT_EMAIL=registrations@immersia.ng

# --- Email campaigns (admin → /admin/email) ---
# Public origin for links INSIDE emails (buttons, portal link, one-click
# unsubscribe). This is NOT the same as APP_URL: in development APP_URL is
# http://localhost:3000, which recipients cannot open — a campaign sent with
# localhost links has a dead unsubscribe and lands in spam. Sending is blocked
# unless this resolves to a public URL.
EMAIL_BASE_URL=https://www.aixrbootcamp.com
# Delivery transport for broadcasts. "smtp" uses the SMTP settings above.
# "console" is a DRY RUN: it writes each rendered email to .mail-outbox/ and
# sends nothing — use it to rehearse a campaign against real data safely.
MAIL_TRANSPORT=smtp
# Messages per minute. Keep this low on Gmail: it defers when pushed hard.
MAIL_RATE_PER_MIN=20
# Max campaign emails per calendar day. A free Gmail account allows ~500
# recipients/day TOTAL, so this default deliberately reserves ~200 for
# transactional mail (receipts, login links) that must never be starved.
# Raise it only after moving to a real ESP on the immersia.ng domain.
MAIL_DAILY_CAMPAIGN_CAP=300
# Messages attempted per drain invocation, and the wall-clock budget for one
# drain. Keep the budget under the platform's function timeout (Vercel Hobby
# allows up to 60s via `maxDuration`).
MAIL_DRAIN_BATCH=25
MAIL_DRAIN_BUDGET_MS=45000
# Shared secret for the daily cron sweep (/api/cron/email-drain) and for
# triggering /api/admin/email/drain without an admin session.
CRON_SECRET=replace-with-a-long-random-string

# --- App ---
APP_URL=http://localhost:3000
# Public canonical site URL — used for SEO metadata, sitemap, robots and OG tags.
NEXT_PUBLIC_SITE_URL=https://www.aixrbootcamp.com
NODE_ENV=development

# --- Meta (Facebook) Pixel ---
# Ads Manager → Events Manager → Data Sources. Fires PageView on the public
# marketing pages only (admin/teacher/portal traffic is deliberately excluded).
# Leave unset to use the live pixel hardcoded as the fallback in
# components/MetaPixel.tsx. Pixel IDs are not secrets — they ship in page source.
NEXT_PUBLIC_META_PIXEL_ID=1678499276571961
